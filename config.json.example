  "apiEndpoints": {
    "supabase": {
      "url": "${SUPABASE_URL}",
      "anonKey": "${SUPABASE_ANON_KEY}",
      "serviceKey": "${SUPABASE_SERVICE_KEY}"
    },
    "timelyai": {
      "baseUrl": "${TIMELY_AI_BASE_URL}",
      "apiKey": "${TIMELY_AI_API_KEY}"
    },
    "higgsfield": {
      "apiUrl": "${HIGGSFIELD_API_URL}",
      "apiKey": "${HIGGSFIELD_API_KEY}"
    }
