# ============================================================================
# 제주소금(JejuSalt) - 통합 환경변수 템플릿 (프로젝트 루트)
# 실제 값은 이 파일을 복사한 .env 에 채우세요 (.env는 git에 커밋되지 않습니다)
# 실제 사용처: implementation/backend (서버 시작), implementation/frontend (Vite 빌드/개발)
# ============================================================================

# SUPABASE (프로젝트 DB)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# 백엔드 서버
NODE_ENV=development
PORT=5000
HOST=localhost

# 프론트엔드 (Vite 전용 - VITE_ 접두사 필수)
VITE_API_URL=http://localhost:5000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================================================
# AI 텍스트 생성 API (Step 1,3,4,5,6,7,9에서 사용 — backend-agent.js callSolarAgent)
# ----------------------------------------------------------------------------
# 현재는 Gemini 무료 버전만 사용하도록 고정되어 있습니다 (AI_PROVIDER=gemini).
# GEMINI_API_KEY가 비어있으면 자동으로 Mock 모드(결정론적 더미 응답)로 동작하여
# 키 없이도 로컬 개발이 가능합니다.
# ============================================================================

AI_PROVIDER=gemini

# Gemini 무료 티어 — https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# --- (참고용, 현재 미사용) Upstage Solar Pro4 — AI_PROVIDER를 upstage로 바꾸면 다시 사용 가능 ---
# UPSTAGE_API_KEY=
# UPSTAGE_MODEL=solar-pro4

# --- (레거시) TimelyAI 브리지 모드 — 더 이상 기본 경로로 사용하지 않음, 참고용으로만 유지 ---
# TIMELY_AI_BASE_URL=https://hello.timelygpt.co.kr/api/v2/chat/bridge/openai
# TIMELY_AI_API_KEY=
# TIMELY_AI_MODEL=upstage/solar-pro4

# ============================================================================
# Higgsfield (기본 모드 - 영상/이미지 생성, 로컬 CLI 인증 방식, API 키 불필요)
# ----------------------------------------------------------------------------
# 매일 한 번 `higgsfield auth login`으로 로컬 세션 토큰을 갱신해야 합니다.
# 크레딧이 소진되면 callHiggsfield()가 실패 결과를 반환하지만 파이프라인 전체는
# 계속 진행됩니다(영상만 null) — 크레딧 충전 후 재생성하면 그대로 동작합니다.
# ============================================================================

# ============================================================================
# Kling AI (테스트 모드 전용 - 카피 확정 화면에서 "테스트 모드"를 체크했을 때만 사용됨)
# ----------------------------------------------------------------------------
# kling.ai/dev/api-key 에서 Access Key / Secret Key 발급.
# ⚠️ 무료 티어는 워터마크 포함 + 상업적 이용 불가 — 파이프라인 연동/테스트 전용이며
# 실제 마케팅 영상에는 절대 사용하면 안 됩니다. 기본 모드(테스트 모드 미체크)는
# 이 키와 무관하게 항상 Higgsfield를 사용합니다.
# ============================================================================
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# KLING_MODEL=kling-v2-6
# KLING_API_BASE_URL=https://api.klingai.com

# 로깅
DEBUG=false
LOG_LEVEL=info
